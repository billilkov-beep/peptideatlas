# Local development. Keep real credentials in .env, never in source control.
PUBLIC_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data/atlas
# The complete source-backed catalogue is installed on first start.
LOAD_CATALOG=true

# Set DATABASE_URL to use a PostgreSQL server. When omitted, local PGlite
# stores PostgreSQL-compatible data in DATA_DIR.
# DATABASE_URL=postgresql://atlas:REPLACE_WITH_PRIVATE_PASSWORD@localhost:5432/atlas

# For Docker Compose, set a random password and an actual HTTPS PUBLIC_URL.
# POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
